---
import { certifications, formatStat, ratings, skills } from '../data/site';
---

<section class="kit wrap" id="kit" aria-labelledby="kit-title">
  <div class="section-head">
    <h2 id="kit-title">Toolkit</h2>
    <span class="mono">Skills and credentials</span>
  </div>

  <dl class="groups" data-reveal="children">
    {skills.map((group) => (
      <div class="group">
        <dt class="mono">{group.label}</dt>
        <dd>{group.items.join(' · ')}</dd>
      </div>
    ))}
  </dl>

  <div class="extras">
    <div data-reveal="children">
      <h3 class="mono">Certifications</h3>
      <ul class="certs">
        {certifications.map((cert) => (
          <li>
            <span>{cert.name}</span>
            <span class="mono">{cert.date}</span>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal="children" data-count-group>
      <h3 class="mono">Competitive programming ratings</h3>
      <dl class="ratings">
        {ratings.map((rating) => (
          <div class="rating">
            <dt>{rating.label}</dt>
            <dd data-count={rating.value}>{formatStat(rating)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .kit {
    padding-top: var(--section);
  }

  .group {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .group dt,
  h3,
  .certs .mono {
    color: var(--faint);
  }

  .group dd {
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .extras {
    display: grid;
    gap: 56px;
    padding-top: clamp(48px, 8vh, 96px);
  }

  h3 {
    font-weight: 400;
  }

  .certs {
    margin-top: 18px;
    border-top: 1px solid var(--line);
  }

  .certs li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(18px, 1.5vw, 22px);
  }

  .certs .mono {
    flex: none;
  }

  .ratings {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 44px;
    margin-top: 22px;
  }

  .rating {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .rating dd {
    font-size: clamp(34px, 3.6vw, 54px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .rating dt {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .group {
      grid-template-columns: minmax(140px, 0.3fr) 1fr;
      align-items: baseline;
    }

    .extras {
      grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 6vw, 110px);
    }
  }
</style>
